#!/usr/bin/env bash
# Lock the screen with hyprlock, coloured from the current juarchy theme.
# Reads ~/.config/hypr/scheme/current.lua and writes hyprlock-colors.conf,
# so the lockscreen follows wallpaper/theme changes like the rest of the shell.

set -u

pidof hyprlock >/dev/null && exit 0

scheme="$HOME/.config/hypr/scheme/current.lua"
out="$HOME/.config/hypr/hyprlock-colors.conf"

colour() {
    # colour <key> <fallback hex>
    local v
    v=$(sed -n "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*\"\([0-9a-fA-F]\{6\}\)\".*/\1/p" "$scheme" 2>/dev/null | head -n1)
    printf '%s' "${v:-$2}"
}

text=$(colour primaryFixed d8e7e3)
dim=$(colour onSurfaceVariant b2a082)
primary=$(colour primary 7daea3)
container=$(colour primaryContainer 42504d)
error=$(colour error ea6962)

cat >"$out" <<EOF
# Generated by ~/.local/bin/juarchy-lock from $scheme. Edits are overwritten.
\$lock_text     = rgba(${text}ff)
\$lock_text_dim = rgba(${dim}ee)
\$lock_outline  = rgba(${primary}aa)
\$lock_field    = rgba(${container}88)
\$lock_check    = rgba(${primary}ff)
\$lock_fail     = rgba(${error}ff)
EOF

exec hyprlock "$@"
