#!/usr/bin/env python3
"""Combined Arch/AUR package installer and separate package removal browser."""

import argparse
import os
from pathlib import Path
import re
import shutil
import shlex
import subprocess
import sys
import time

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / 'lib'))
from jubal_launcher.terminal import run_removal
from jubal_launcher.package_guidance import (
    OFFICIAL_REPOS, FAMILIES, aur_metadata, build_label, clean, contested_bases, decorate, guidance,
    repo_choices, repo_descriptions, suggested_arch_rows,
)


CACHE_HOME = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache"))
AUR_CACHE = CACHE_HOME / "jubal-launcher/aur-packages.txt"
YAY_CACHE = CACHE_HOME / "yay/completion.cache"
PACKAGE = re.compile(r"[A-Za-z0-9@_+][A-Za-z0-9@._+-]*")


def target_valid(target, source):
    if source == "remove":
        return bool(PACKAGE.fullmatch(target))
    parts = target.split("/")
    if len(parts) != 2 or not all(PACKAGE.fullmatch(part) for part in parts):
        return False
    if source == "all":
        return True
    if source == "aur":
        return parts[0] in ("aur", *OFFICIAL_REPOS)
    return source == "arch" and parts[0] != "aur"


def query(command, timeout=30):
    try:
        result = subprocess.run(command, text=True, capture_output=True, timeout=timeout)
    except subprocess.TimeoutExpired as exc:
        raise RuntimeError("Package lookup timed out. Check your connection and try Ctrl+R.") from exc
    if result.returncode:
        raise RuntimeError(result.stderr.strip() or "Package lookup failed")
    return result.stdout


def cached_aur():
    # Yay's completion cache contains both AUR and repository packages.
    # Only the explicitly marked AUR rows belong in this browser.
    candidates = []
    for path in (AUR_CACHE, YAY_CACHE):
        try:
            stamp = path.stat().st_mtime
            text = path.read_text()
        except OSError:
            continue
        names = []
        for line in text.splitlines():
            parts = line.split()
            if path == YAY_CACHE:
                if len(parts) != 2 or parts[1] != "AUR":
                    continue
            if parts and PACKAGE.fullmatch(parts[0]):
                names.append(parts[0])
        if names:
            candidates.append((stamp, names))
    return max(candidates, key=lambda item: item[0]) if candidates else (0, [])


def repository_rows():
    rows = []
    for line in query(["pacman", "-Sl"]).splitlines():
        parts = line.split()
        if len(parts) >= 3:
            target = parts[0] + "/" + parts[1]
            if target_valid(target, "arch"):
                rows.append(target + "  " + " ".join(parts[2:]))
    if not rows:
        raise RuntimeError("No repository packages found in the local pacman databases.")
    return rows


def load_packages(source, refresh=False, source_filter="all"):
    if source == "all" and source_filter == "arch":
        return load_packages("arch", refresh)
    if source == "remove":
        rows = []
        for line in query(["pacman", "-Qe"]).splitlines():
            parts = line.split()
            if len(parts) == 2 and target_valid(parts[0], source):
                rows.append(parts[0] + "  " + parts[1])
        return rows, "Explicitly installed packages · Arch + AUR · pacman will confirm removal"
    if source == "arch":
        rows = repository_rows()
        return decorate(rows, repo_choices(rows), repo_descriptions()), "Arch packages · Recommended first · stable Arch preferred · local database"

    stamp, names = cached_aur()
    notice = "AUR · cached index · Ctrl+R refreshes"
    if refresh or not names or time.time() - stamp > 86400:
        print("Loading the AUR package index…", file=sys.stderr, flush=True)
        try:
            fetched = sorted({name for name in query(["yay", "-Slqa"], timeout=45).splitlines()
                              if PACKAGE.fullmatch(name)})
            if not fetched:
                raise RuntimeError("The AUR returned an empty package index.")
        except (RuntimeError, OSError) as exc:
            if not names and source != "all":
                raise
            notice = "AUR · offline cached index · Ctrl+R retries" if names else "AUR unavailable · Ctrl+R retries"
            print(f"{exc}\n" + ("Using the cached AUR index." if names else "Showing available Arch packages."), file=sys.stderr)
        else:
            names = fetched
            notice = "AUR · refreshed package index"
            AUR_CACHE.parent.mkdir(parents=True, exist_ok=True)
            temporary = AUR_CACHE.with_name(f"aur-packages.{os.getpid()}.tmp")
            try:
                temporary.write_text("\n".join(names) + "\n")
                temporary.replace(AUR_CACHE)
            finally:
                temporary.unlink(missing_ok=True)
    installed = set(query(["pacman", "-Qq"]).splitlines())
    repos = repository_rows()
    choices = repo_choices(repos)
    candidates = {f["aur"] for f in FAMILIES if f.get("aur") and f["aur"] in names}
    metadata, current = aur_metadata(candidates, refresh)
    rows = ["aur/" + name + ("  [installed]" if name in installed else "") for name in sorted(set(names))]
    if source == "all":
        if source_filter != "aur":
            rows.extend(repos)
        notice = "Arch + " + notice + " · stable Arch preferred"
    else:
        suggestions = set(suggested_arch_rows(choices, names))
        rows.extend(row for row in repos if row.split()[0] in suggestions)
        notice += " · stable Arch recommendations included"
    if not current:
        notice += " · AUR status unverified"
    unique = {row.split()[0]: row for row in rows}
    return decorate(list(unique.values()), choices, repo_descriptions(), metadata, current), notice


def picker_command(source, notice, source_filter="all"):
    removing = source == "remove"
    title = {"all": "Install packages", "arch": "Arch packages", "aur": "AUR packages", "remove": "Remove packages"}[source]
    script = shlex.quote(str(Path(__file__).resolve()))
    preview = "pacman -Qi -- {1}" if removing else f"{script} {source} --preview {{1}}"
    operation = "Search and uninstall" if removing else "Search and install"
    enter_hint = "Enter reviews removal" if removing else "Enter installs"
    preview_hint = " Alt+P details · Alt+J/K scroll "
    if removing:
        preview_hint = " Package details and dependencies · Alt+P toggle · Alt+J/K scroll "
    header = notice + "\nType to search · Tab selects · " + enter_hint + " · Esc closes · Ctrl+R reloads"
    if not removing:
        header = notice + "\nSearch names or aliases · Recommended first · Ctrl+S relevance sort\nTab selects · Enter installs · Alt+P details · Ctrl+R reloads · Esc closes"
    if source == "all":
        header += "\nFilters: Ctrl+A All · Ctrl+O Arch only · Ctrl+U AUR only"
    prompt = {"all": "All packages", "arch": "Arch only", "aur": "AUR only"}[source_filter] if source == "all" else title
    command = [
        "fzf", "--multi", "--layout=reverse", "--border=rounded",
        "--border-label", f" {title} · {operation} ",
        "--prompt", f"{prompt} > ", "--nth=1" if removing else "--nth=1,3", "--expect=enter,ctrl-r",
        "--header", header,
        "--preview", preview, "--preview-window=down:55%:wrap",
        "--preview-label", preview_hint + ("· Alt+B PKGBUILD · Alt+I info " if source in ("all", "aur") else ""),
        "--bind", "alt-p:toggle-preview,alt-j:preview-down,alt-k:preview-up",
        "--color", ("pointer:#ffb4ab,marker:#ffb4ab,border:#ffb4ab,label:#ffb4ab" if removing
                    else "pointer:#a8c8ff,marker:#ebb5ec,border:#a8c8ff,label:#a8c8ff"),
    ]
    if source in ("all", "aur"):
        command += ["--bind", f"alt-b:change-preview({script} {source} --build-preview {{1}}),alt-i:change-preview({preview})"]
    if not removing:
        command += ["--delimiter=\t", "--exact", "--no-sort", "--no-hscroll", "--bind", "ctrl-s:toggle-sort"]
    if source == "all":
        for key, mode, label in (("ctrl-a", "all", "All packages"), ("ctrl-o", "arch", "Arch only"), ("ctrl-u", "aur", "AUR only")):
            reload = f"{script} all --list --source-filter {mode}"
            command += ["--bind", f"{key}:clear-selection+change-prompt({label} > )+reload({reload})"]
    return command


def filter_rows(rows, source_filter):
    if source_filter == "all":
        return rows
    return [row for row in rows if row.startswith("aur/") == (source_filter == "aur")]


def select_packages(source, rows, notice, source_filter="all", allowed_rows=None):
    # Keep external fzf defaults from adding bindings or changing output format.
    env = {key: value for key, value in os.environ.items()
           if key not in ("FZF_DEFAULT_OPTS", "FZF_DEFAULT_OPTS_FILE")}
    result = subprocess.run(picker_command(source, notice, source_filter), input="\n".join(rows) + "\n",
                            text=True, stdout=subprocess.PIPE, env=env)
    if result.returncode in (1, 130):
        return "cancel", []
    if result.returncode:
        raise RuntimeError(f"Package browser exited with status {result.returncode}")
    lines = result.stdout.splitlines()
    if not lines or lines[0] not in ("enter", "ctrl-r"):
        raise RuntimeError("Package browser returned an unexpected selection")
    if lines[0] == "ctrl-r":
        return "refresh", []
    allowed = {row.split()[0] for row in (allowed_rows if allowed_rows is not None else rows)}
    targets = list(dict.fromkeys(line.split()[0] for line in lines[1:] if line.strip()))
    if any(target not in allowed or not target_valid(target, source) for target in targets):
        raise RuntimeError("Package selection does not belong to this source")
    return "remove" if source == "remove" else "install", targets


def install_command(source, targets):
    if source not in ("all", "arch", "aur") or not targets or any(not target_valid(target, source) for target in targets):
        raise ValueError("Select at least one package from this source")
    if source == "arch" or all(not t.startswith("aur/") for t in targets):
        command = ["sudo", "pacman", "-S"]
    elif all(t.startswith("aur/") for t in targets):
        command = ["yay", "-S", "--aur"]
    else:
        command = ["yay", "-S"]  # Explicit repo prefixes preserve each choice.
    return [*command, "--needed", "--confirm", "--", *targets]


def preview_package(source, target, build=False):
    if source == "remove" or not target_valid(target, source):
        raise ValueError("Invalid package preview")
    repo, name = target.split("/", 1)
    choices = repo_choices(repository_rows())
    metadata, current = aur_metadata([name]) if repo == "aur" else ({}, False)
    contested = contested_bases(cached_aur()[1]) if source != "arch" else frozenset()
    tags, reason, _ = guidance(target, choices, metadata, current, contested)
    print(target, flush=True)
    if build_label(target):
        print(build_label(target), flush=True)
    print(" · ".join(tags), flush=True)
    if reason:
        print("\n" + reason, flush=True)
    if repo == "aur":
        record = metadata.get(name)
        print("\nPackage page: https://aur.archlinux.org/packages/" + name, flush=True)
        if record:
            print("Description: " + clean(record.get("Description")), flush=True)
            print("Upstream: " + clean(record.get("URL")), flush=True)
            print("Maintainer: " + clean(record.get("Maintainer") or "Orphaned"), flush=True)
            print(f"Votes: {record.get('NumVotes', '?')} · Popularity: {record.get('Popularity', '?')}", flush=True)
        print("Maintenance: " + ("current AUR metadata" if current else "unverified; cached details may be stale"), flush=True)
    print("", flush=True)
    command = (["yay", "-Gpa", "--", target] if build and repo == "aur"
               else ["yay", "-Siia", "--", target] if repo == "aur"
               else ["pacman", "-Sii", "--", target])
    try:
        print(query(command, timeout=20))
    except RuntimeError as exc:
        print(str(exc))
    return 0


def remove_command(targets):
    if not targets or any(not target_valid(target, "remove") for target in targets):
        raise ValueError("Select at least one installed package to remove")
    # Recheck after selection; only exact installed names may reach pacman.
    installed = set(query(["pacman", "-Qq"]).splitlines())
    missing = [target for target in targets if target not in installed]
    if missing:
        raise ValueError("Packages are no longer installed: " + ", ".join(missing))
    return ["sudo", "pacman", "-Rns", "--confirm", "--", *dict.fromkeys(targets)]


def browse(source, source_filter="all"):
    required = ["fzf", "pacman", "sudo"] + (["yay"] if source == "aur" else [])
    missing = [name for name in required if not shutil.which(name)]
    if missing:
        raise RuntimeError("Missing application(s): " + ", ".join(missing))
    refresh = False
    while True:
        description = {"all": "Arch and AUR", "arch": "Arch repository", "aur": "AUR", "remove": "installed"}[source]
        print(f"Loading {description} packages…", flush=True)
        # Keep the full allowed set for validating selections after in-window
        # source filters reload fzf with subsets of this same catalogue.
        rows, notice = load_packages(source, refresh)
        if not rows:
            print("No packages to show.")
            return 0
        initial_rows = rows
        if source == "all" and source_filter != "all":
            initial_rows = filter_rows(rows, source_filter)
        action, targets = select_packages(source, initial_rows, notice, source_filter, allowed_rows=rows)
        if action == "cancel":
            return 0
        refresh = action == "refresh"
        if refresh or not targets:
            continue
        print("\nSelected packages:\n  " + "\n  ".join(targets), flush=True)
        if source == "remove":
            print("Removes selected packages and dependencies no longer needed.\n"
                  "Package-managed configuration files are removed without .pacsave backups.\n"
                  "Review pacman's complete list before confirming.\n", flush=True)
            command = remove_command(targets)
            return run_removal(command, targets)
        else:
            command = install_command(source, targets)
        result = subprocess.run(command, check=False)
        operation = "Removal" if source == "remove" else "Installation"
        print("\nPackage command completed." if result.returncode == 0
              else f"\n{operation} did not complete (status {result.returncode}).")
        if input("Enter to return to search, or q to close: ").strip().lower() == "q":
            return 0


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("source", choices=("all", "arch", "aur", "remove"), nargs="?", default="all")
    parser.add_argument("--source-filter", choices=("all", "arch", "aur"), default="all", help="Initial source filter in the combined browser")
    parser.add_argument("--list", action="store_true", help="Print the package index without opening a browser or changing packages")
    parser.add_argument("--preview", metavar="TARGET", help="Show package guidance and metadata without installing")
    parser.add_argument("--build-preview", metavar="TARGET", help="Show AUR build recipe without installing")
    args = parser.parse_args()
    try:
        if args.preview or args.build_preview:
            return preview_package(args.source, args.preview or args.build_preview, bool(args.build_preview))
        if args.list:
            rows, notice = load_packages(args.source, source_filter=args.source_filter)
            print(notice, file=sys.stderr)
            print("\n".join(rows))
            return 0
        return browse(args.source, args.source_filter)
    except (OSError, ValueError, RuntimeError) as exc:
        print(f"\nPackage browser: {exc}", file=sys.stderr)
        if not args.list and sys.stdin.isatty():
            input("Press Enter to close: ")
        return 1
    except (KeyboardInterrupt, EOFError):
        return 0


if __name__ == "__main__":
    sys.exit(main())
